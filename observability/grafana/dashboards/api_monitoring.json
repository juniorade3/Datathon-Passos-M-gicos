    "panels": [
        {
            "title": "📊 Métricas da API",
            "type": "row",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "collapsed": false
        },
        {
            "title": "Requests por Segundo",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": ""
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 20,
                        "gradientMode": "scheme",
                        "spanNulls": true
                    },
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "rate(http_requests_total{job=\"passos-magicos-api\"}[1m])",
                    "legendFormat": "{{method}} {{handler}} {{status}}",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Latência p50 / p95 / p99",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": ""
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10,
                        "gradientMode": "scheme"
                    },
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"passos-magicos-api\"}[1m]))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"passos-magicos-api\"}[1m]))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"passos-magicos-api\"}[1m]))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ]
        },
        {
            "title": "Taxa de Erros (HTTP 4xx/5xx)",
