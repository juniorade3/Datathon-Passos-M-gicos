                "overrides": []
            },
            "targets": [
                {
                    "expr": "rate(http_requests_total{job=\"passos-magicos-api\", status=~\"4..|5..\"}[1m])",
                    "legendFormat": "{{status}} {{handler}}",
                    "refId": "A"
